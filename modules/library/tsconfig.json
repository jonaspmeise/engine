{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "ESNext.Iterator"],
    "types": ["bun-types", "bun", "bun-types/globals"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "files": [],
  "references": [
    { "path": "modules/library" },
    { "path": "modules/client-singleplayer" },
    { "path": "modules/client-p2p" },
    { "path": "modules/server" }
  ]
}
