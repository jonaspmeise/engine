{
  "name": "@my-engine/client-singleplayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@my-engine/library": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example:tictactoe:run": "bun --hot examples/tictactoe/index.html",
    "example:tictactoe:build": "bun build ./examples/tictactoe/tictactoe.ts --outdir ./examples/tictactoe/dist --target browser",
    "example:uno:run": "bun --hot examples/uno/index.html",
    "example:uno:build": "bun build ./examples/uno/uno.ts --outdir ./examples/uno/dist --target browser"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9"
  }
}