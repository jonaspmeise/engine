{
  "name": "my-engine",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "typecheck": "tsc -b",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  }
}
